generator client {
  provider = "prisma-client-js"
}

// FOR LOCAL DEVELOPMENT (SQLite):
// datasource db {
//   provider = "sqlite"
// }

datasource db {
  provider = "postgresql"
}

model Game {
  id          String   @id @default(uuid())
  title       String
  developer   String
  rating      Float
  genre       String
  price       Float
  discount    Float
  coverImage  String
  releaseDate String
  platforms        String   // Comma separated string for simplicity, or JSON
  isRentable       Boolean  @default(false)
  outOfStock       Boolean  @default(false)
  isGiveaway       Boolean  @default(false)
  giveawayRules    String?
  rentPrice        Float?
  rentDurationDays Int?     @default(7)
  rentRules        String?
  minRequirements  String?
  recRequirements  String?
  trailerUrl       String?
  screenshots      String?
  tagImage         String?
  steamAppId       String?
  creatorAccess    Boolean  @default(false)
  position         Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt


  
  cartItems        CartItem[]
  wishlistItems    WishlistItem[]
  orderItems       OrderItem[]
  reactions        GameReaction[]
}

model User {
  id        String   @id @default(uuid())
  username         String   @unique
  email            String   @unique
  password         String?
  steamMonUsername String?
  steamMonPassword String?
  createdAt        DateTime @default(now())

  
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orders        Order[]
  reactions     GameReaction[]
  creatorApplications CreatorApplication[]
  creatorCoupons      Coupon[]             @relation("CreatorCoupons")
}

model GameReaction {
  id        String   @id @default(uuid())
  userId    String
  gameId    String
  type      String   // "LIKE" or "DISLIKE"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
}


model CartItem {
  id        String   @id @default(uuid())
  userId    String
  gameId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  gameId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
}

model Order {
  id               String      @id @default(uuid())
  userId           String
  status           String      @default("PENDING") // PENDING, COMPLETED, CANCELLED, EXPIRED
  totalAmount      Float
  couponCode       String?
  couponDiscount   Float?
  commissionEarned Float?
  purpose          String?     @unique // e.g. DX-K8M2P5R1Q7 for Delta APay UPI
  submittedUtr     String?
  paymentMethod    String      @default("DELTA_PAY")
  expiresAt        DateTime?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       OrderItem[]
  transaction Transaction?
}

model Transaction {
  id            String    @id @default(uuid())
  utr           String    @unique
  amount        Float
  transactionId String
  sender        String
  date          String
  
  orderId       String?   @unique
  order         Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  
  createdAt     DateTime  @default(now())
}

model ParsedEmail {
  id        String   @id @default(uuid())
  messageId String   @unique
  status    String   @default("PROCESSED")
  createdAt DateTime @default(now())
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  gameId    String
  pricePaid Float
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  game  Game  @relation(fields: [gameId], references: [id], onDelete: Cascade)
}

model Coupon {
  id          String   @id @default(uuid())
  code        String   @unique
  discount    Float
  createdBy   String
  usageLimit  Int?
  usageCount      Int      @default(0)
  isActive        Boolean  @default(true)
  creatorId       String?
  commissionRate  Float?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  creator         User?    @relation("CreatorCoupons", fields: [creatorId], references: [id], onDelete: SetNull)
}

model Poster {
  id        String   @id @default(uuid())
  imageUrl  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model CreatorApplication {
  id               String   @id @default(uuid())
  userId           String
  name             String
  youtubeLink      String?
  instagramLink    String?
  facebookLink     String?
  otherLink        String?
  intent           String
  contactPlatforms String   // JSON string storing selected methods
  creatorEmail     String
  status           String   @default("PENDING") // PENDING, APPROVED, REJECTED
  agreedToGuidelines Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OtpVerification {
  id        String   @id @default(uuid())
  email     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}