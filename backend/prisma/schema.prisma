generator client {
  provider = "prisma-client-js"
}

// FOR LOCAL DEVELOPMENT (SQLite):
// datasource db {
//   provider = "sqlite"
// }

datasource db {
  provider = "postgresql"
}

model Game {
  id          String   @id @default(uuid())
  title       String
  developer   String
  rating      Float
  genre       String
  price       Float
  discount    Float
  coverImage  String
  releaseDate String
  platforms        String   // Comma separated string for simplicity, or JSON
  isRentable       Boolean  @default(false)
  outOfStock       Boolean  @default(false)
  isGiveaway       Boolean  @default(false)
  giveawayRules    String?
  rentPrice        Float?
  rentDurationDays Int?     @default(7)
  rentRules        String?
  minRequirements  String?
  recRequirements  String?
  trailerUrl       String?
  screenshots      String?
  tagImage         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  
  cartItems        CartItem[]
  wishlistItems    WishlistItem[]
  orderItems       OrderItem[]
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orders        Order[]
  creatorApplications CreatorApplication[]
}

model CartItem {
  id        String   @id @default(uuid())
  userId    String
  gameId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  gameId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId])
}

model Order {
  id          String      @id @default(uuid())
  userId      String
  status      String      @default("PENDING") // PENDING, COMPLETED, CANCELLED
  totalAmount Float
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items       OrderItem[]
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  gameId    String
  pricePaid Float
  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  game  Game  @relation(fields: [gameId], references: [id], onDelete: Cascade)
}

model Coupon {
  id          String   @id @default(uuid())
  code        String   @unique
  discount    Float
  createdBy   String
  usageLimit  Int?
  usageCount  Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Poster {
  id        String   @id @default(uuid())
  imageUrl  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model CreatorApplication {
  id               String   @id @default(uuid())
  userId           String
  name             String
  youtubeLink      String?
  instagramLink    String?
  facebookLink     String?
  otherLink        String?
  intent           String
  contactPlatforms String   // JSON string storing selected methods
  creatorEmail     String
  status           String   @default("PENDING") // PENDING, APPROVED, REJECTED
  agreedToGuidelines Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}